{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "openscad",
      "camelcase": "Openscad",
      "scope": "source.openscad",
      "path": ".",
      "file-types": [
        "scad"
      ],
      "injection-regex": "^(open)?scad$"
    }
  ],
  "metadata": {
    "version": "0.7.1",
    "license": "MIT",
    "description": "OpenSCAD grammar for tree-sitter",
    "authors": [
      {
        "name": "Mikhail Katychev",
        "email": "mkatych@gmail.com"
      },
      {
        "name": "Ian Boll",
        "email": "mainbollian@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/openscad/tree-sitter-openscad"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
